        "        boxstyle=\"round,pad=0.05\", color=color, zorder=2))\n",
        "    ax.text(3, yi + 0.08, name, ha='center', va='center',\n",
        "            fontsize=10, fontweight='bold', zorder=3)\n",
        "    ax.text(3, yi - 0.16, sub, ha='center', va='center',\n",
        "            fontsize=8, color='#333', zorder=3)\n",
        "\n",
        "# Straight arrows top to bottom\n",
        "for i in range(len(nodes) - 1):\n",
        "    y1 = y[nodes[i][0]] - 0.31\n",
        "    y2 = y[nodes[i+1][0]] + 0.31\n",
        "    ax.annotate('', xy=(3, y2), xytext=(3, y1),\n",
        "                arrowprops=dict(arrowstyle='->', color='#444', lw=1.2))\n",
        "\n",
        "# Residual: x_1 -> add (dashed line on left)\n",
        "ax.plot([1.3, 1.3], [y['x_1'] - 0.3, y['add'] + 0.3],\n",
