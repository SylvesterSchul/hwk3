        "ax.annotate('', xy=(1.3, y['add'] + 0.3), xytext=(1.3, y['add'] + 0.6),\n",
        "            arrowprops=dict(arrowstyle='->', color='#888', lw=1))\n",
        "ax.text(0.75, (y['x_1'] + y['add']) / 2, 'residual',\n",
        "        fontsize=7, color='#888', ha='center', rotation=90)\n",
        "\n",
        "ax.legend(handles=[\n",
        "    mpatches.Patch(color='#B4B2A9', label='Input'),\n",
        "    mpatches.Patch(color='#AFA9EC', label='Matrix multiply'),\n",
        "    mpatches.Patch(color='#5DCAA5', label='Activation / add'),\n",
        "    mpatches.Patch(color='#F4A261', label='Layer norm'),\n",
        "    mpatches.Patch(color='#F0997B', label='Output'),\n",
        "], loc='lower right', fontsize=8)\n",
